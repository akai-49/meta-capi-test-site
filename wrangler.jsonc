{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meta-capi-test-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
